DATABASE_URL=postgresql+asyncpg://user:password@localhost:5533/postgres
SYNC_DATABASE_URL=postgresql+psycopg://user:password@localhost:5533/postgres
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5533
VITE_API_BASE_URL=http://localhost:8000
# ML pipeline: true = fabricated/simulated results (no heavy deps); false = run
# the real reviewscope_ml pipeline. docker-compose overrides this to false for
# the api/worker services.
SIMULATE_ML=true
ML_DEVICE=cpu
# cuda = request idle GPU(s) per run (falls back to CPU when all are busy);
# ML_MAX_GPUS caps the cards one run may claim (0 = every idle card).
ML_MAX_GPUS=1
# GPU hosts: merge an override into the CPU-only docker-compose.yml, e.g.
#   COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml    (nvidia-container-toolkit)
#   COMPOSE_FILE=docker-compose.yml:docker-compose.ltgpu.yml  (ltgpu1)
